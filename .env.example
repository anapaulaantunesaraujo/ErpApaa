# Configurações do Banco de Dados PostgreSQL
POSTGRES_PORT=5433
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_secret_password
POSTGRES_DB=erp_apaa
DATABASE_URL="postgresql://erp_user:erp_secret_password@localhost:5433/erp_apaa?schema=public"

# Segredo para assinatura de Tokens JWT de Sessão
JWT_SECRET="erp_apaa_chave_secreta_jwt_2026_substituir_em_producao"

# Porta da aplicação
PORT=3000
NODE_ENV=development

# Configuração Oficial do E-mail APAA (Gmail IMAP / SMTP)
GMAIL_USER="apaaerp@gmail.com"
GMAIL_APP_PASS="sua_senha_de_app_aqui"
GMAIL_FOLDER="APAA_FINANCEIRO"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="apaaerp@gmail.com"
SMTP_PASS="sua_senha_de_app_aqui"
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993

